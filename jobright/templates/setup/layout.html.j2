{% extends "dash/base.html.j2" %}
{% block title %}Set up jobright{% endblock %}
{% block body %}
<style>
  .steps { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:18px; }
  .steps a { text-decoration:none; padding:6px 10px; border-radius:8px; border:1px solid var(--line); color:var(--muted); font-size:13.5px; }
  .steps a.done { color:var(--ok); border-color:var(--ok); }
  .steps a.on { background:var(--accent); border-color:var(--accent); color:var(--accent-ink); }
  .form-grid { display:grid; grid-template-columns: minmax(180px, 320px) 1fr; gap:10px 16px; align-items:center; }
  @media (max-width: 700px) { .form-grid { grid-template-columns: 1fr; } }
  .help { font-size:12.5px; color:var(--muted); }
  .err { color:var(--bad); margin:8px 0; }
  .pill-list label { display:inline-flex; gap:6px; align-items:center; margin:0 12px 8px 0; }
  textarea.code { font:12.5px/1.45 ui-monospace, Menlo, monospace; min-height:420px; }
  input[type=number], input[type=password], input[type=file] { font:inherit; padding:6px 8px; border:1px solid var(--line); border-radius:7px; background:var(--card); color:var(--ink); width:100%; }
</style>
{% set s = status %}
<div class="steps">
  <a href="/setup/key" class="{{ 'done' if s.key }} {{ 'on' if step == 'key' }}">1 · API key</a>
  <a href="/setup/resume" class="{{ 'done' if s.resume }} {{ 'on' if step == 'resume' }}">2 · Resume</a>
  <a href="/setup/country" class="{{ 'done' if s.country }} {{ 'on' if step == 'country' }}">3 · Country & sites</a>
  <a href="/setup/plan" class="{{ 'done' if s.plan }} {{ 'on' if step == 'plan' }}">4 · Career plan</a>
  <a href="/setup/answers" class="{{ 'done' if s.answers }} {{ 'on' if step == 'answers' }}">5 · Answers</a>
  <a href="/setup/logins" class="{{ 'done' if s.logins }} {{ 'on' if step == 'logins' }}">6 · Sign in</a>
  <a href="/setup/finish" class="{{ 'done' if s.done }} {{ 'on' if step == 'finish' }}">7 · Go</a>
</div>
{% if error %}<p class="err">{{ error }}</p>{% endif %}
{% block step %}{% endblock %}
{% endblock %}
