{% extends "setup/layout.html.j2" %}
{% block step %}
<h1>Welcome to jobright</h1>
<p>jobright finds jobs that fit you, writes an honest tailored resume for each, and applies for you, with you in control. Setup takes about 10 minutes. Everything stays on this computer.</p>
<div class="card">
  <ol style="margin:0; padding-left:18px; line-height:1.9">
    <li><a href="/setup/key">Pick the AI engine</a> {% if status.key %}<span class="st-applied">✓</span>{% endif %}<span class="help"> (free works with no key; a Claude key is optional)</span></li>
    <li><a href="/setup/resume">Upload your resume</a> {% if status.resume %}<span class="st-applied">✓</span>{% endif %}<span class="help"> (PDF or Word; it becomes your fact base)</span></li>
    <li><a href="/setup/country">Choose country, cities and job sites</a> {% if status.country %}<span class="st-applied">✓</span>{% endif %}</li>
    <li><a href="/setup/plan">Get your career plan and pick role tracks</a> {% if status.plan %}<span class="st-applied">✓</span>{% endif %}</li>
    <li><a href="/setup/answers">Answer the questions forms always ask</a> {% if status.answers %}<span class="st-applied">✓</span>{% endif %}</li>
    <li><a href="/setup/logins">Sign in to each job site</a> {% if status.logins %}<span class="st-applied">✓</span>{% endif %}</li>
    <li><a href="/setup/finish">Choose limits and start</a> {% if status.done %}<span class="st-applied">✓</span>{% endif %}</li>
  </ol>
</div>
<p class="help">Nothing is ever invented: resumes only reuse facts from your own resume, and questions only you can answer (salary, visa, notice…) are asked once and saved.</p>
{% endblock %}
